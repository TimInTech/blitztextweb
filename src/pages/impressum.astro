---
import Base from '../layouts/Base.astro';
import { dicts } from '../i18n';

const dict = dicts.de;
const title = 'Impressum – Blitztext Linux';
const description = 'Impressum der Produktwebsite von Blitztext Linux.';
---

<Base dict={dict} title={title} description={description} path="/impressum/" altPath={null}>
  <section class="section">
    <div class="container prose">
      <h1>Impressum</h1>

      <h2>Angaben gemäß §&nbsp;5 DDG</h2>
      <p>
        TimInTech<br />
        Tim Baumann<br />
        Schulstr. 12<br />
        33818 Leopoldshöhe<br />
        Deutschland
      </p>

      <h2>Kontakt</h2>
      <p>
        E-Mail:
        <a href="mailto:gummiflip@outlook.de">gummiflip@outlook.de</a>
      </p>

      <h2>Verantwortlich für den Inhalt</h2>
      <p>
        Tim Baumann<br />
        Schulstr. 12<br />
        33818 Leopoldshöhe
      </p>

      <h2>Hinweis zum Projekt</h2>
      <p>
        Diese Website ist die Produktseite des Open-Source-Projekts
        <a href="https://github.com/TimInTech/blitztext-linux" rel="noopener">Blitztext Linux</a>
        (MIT-Lizenz). Sie ist ein nicht-kommerzielles Projektangebot.
      </p>

      <h2>Haftung für Links</h2>
      <p>
        Diese Website verlinkt auf externe Seiten Dritter (insbesondere GitHub), auf deren
